{
  "name": "gewen",
  "version": "1.0.2",
  "description": "Gewen 3D Windows 桌面宠物",
  "author": "MoneyNode",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:dir": "electron-builder --win --dir",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.moneynode.gewen",
    "productName": "Gewen",
    "npmRebuild": false,
    "compression": "store",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
